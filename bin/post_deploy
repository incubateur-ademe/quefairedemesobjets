#!/bin/bash
set -euo pipefail

cd /app/webapp

python manage.py createcachetable
python manage.py migrate
python manage.py populate_libelle_court

python manage.py seed_lieux_de_depot

# Grid of consignes of the live fiches, from their first row of cards.
# No-op on a fiche that already has one.
# TODO: remove once the consignes grid is live in production.
python manage.py generate_consignes

# TEMPORARY, required to have search function after deploy
python manage.py enable_unaccent
python manage.py enable_trigram

python manage.py clearsessions
python manage.py clear_cache --all
python manage.py create_remote_db_server

# Purge orphan base SearchTerm index entries (django-modelsearch #58). Idempotent.
python manage.py purge_orphan_searchterm_index
