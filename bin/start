#!/bin/bash
set -euo pipefail

gunicorn core.wsgi \
  --bind unix:/tmp/gunicorn.sock \
  --worker-class gthread \
  --preload \
  --timeout 120 \
  --workers "${GUNICORN_WORKERS:-2}" \
  --threads "${GUNICORN_THREADS:-8}" \
  --max-requests 1000 \
  --chdir /app/webapp \
  --max-requests-jitter "${GUNICORN_MAX_REQUESTS_JITTER:-500}" & /app/bin/run
