ENVIRONMENT=development
# Required because this variable in /core/settings.py
# was intentionally left null by default
# for security reasons
# See PR: https://github.com/incubateur-ademe/quefairedemesobjets/pull/1189
SECRET_KEY='my-secret-key' # pragma: allowlist secret

# AIRFLOW
_AIRFLOW_DB_MIGRATE=true
_AIRFLOW_WWW_USER_CREATE=true

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

## CORE
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
# following https://airflow.apache.org/docs/apache-airflow/stable/security/secrets/fernet.html
AIRFLOW__CORE__FERNET_KEY=''
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION='true'
AIRFLOW__CORE__LOAD_EXAMPLES='false'
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__AUTH_MANAGER='airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager'
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/
# Allow deserialization of project-internal classes (Pydantic configs, etc.)
# pushed to XCom. Airflow 3's serde framework handles DataFrames, BaseModel
# and numpy types natively
AIRFLOW__CORE__ALLOWED_DESERIALIZATION_CLASSES_REGEXP=airflow\..* acteurs\..* clone\..* cluster\..* crawl\..* enrich\..* shared\..* sources\..* stats\..* suggestions\..* tools\..* utils\..*

## API
AIRFLOW__API__AUTH_BACKENDS='airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session'
AIRFLOW__API_AUTH__JWT_SECRET='<jwt-token-blah-blah-blah>'
# Enlarge the modal (trigger DAG, etc.) to 90% of the screen width
AIRFLOW__API__THEME='{"globalCss":{"[data-scope=\"dialog\"][data-part=\"content\"]":{"max-width":"95vw !important"}}}'

## WEBSERVER
AIRFLOW__WEBSERVER__EXPOSE_CONFIG='true'
AIRFLOW__WEBSERVER__WORKERS='2'
AIRFLOW__WEBSERVER__WARN_DEPLOYMENT_EXPOSURE='false'
AIRFLOW__WEBSERVER__X_FRAME_ENABLED='false'

## LOGGER
# Uncomment the next 4 lines to store logs in S3
# AIRFLOW__LOGGING__REMOTE_LOGGING='true'
# AIRFLOW__LOGGING__REMOTE_BASE_LOG_FOLDER="s3://lvao-dev-airflow"
# AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID='log_default'
# AIRFLOW__LOGGING__ENCRYPT_S3_LOGS="false"
# AIRFLOW_CONN_LOG_DEFAULT=aws://…

## SCHEDULER
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK='true'
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT='false'

# DAG PROCESSOR
# replace AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW__DAG_PROCESSOR__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW__DAG_PROCESSOR__PARSING_PROCESSES=1

## DATABASE
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db/airflow # pragma: allowlist secret
AIRFLOW__DATABASE__SQL_ALCHEMY_CONNECT_ARGS=airflow_local_settings.keepalive_kwargs
# We need to repeat this env variable to use it in data-platform/scripts/db_cleanup.sh,
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN is not accessible
AIRFLOW_METADATA_DB_URL=postgresql+psycopg2://airflow:airflow@airflow-db/airflow # pragma: allowlist secret

AIRFLOW_CONN_WEBAPP_DB='postgres://webapp:webapp@lvao-webapp-db:5432/webapp' # pragma: allowlist secret

# DOCKER / AIRFLOW

# WARNING=Use _PIP_ADDITIONAL_REQUIREMENTS option ONLY for a quick checks
# for other purpose (development, test and especially production usage) build/extend Airflow image.
_PIP_ADDITIONAL_REQUIREMENTS=${_PIP_ADDITIONAL_REQUIREMENTS:-}

### CONNECTOR
AIRFLOW_CONN_WEBAPP_DB='postgres://webapp:webapp@lvao-webapp-db:5432/webapp' # pragma: allowlist secret
DATABASE_URL=postgres://webapp:webapp@lvao-webapp-db:5432/webapp # pragma: allowlist secret
# Webapp URL for API calls from DAGs
# (e.g. acteur model metadata when parsing DAGs)
# Locally, the webapp runs on the host (make runserver)
WEBAPP_URL=http://host.docker.internal:8000
DB_WEBAPP_SAMPLE=postgres://webapp_sample:webapp_sample@lvao-webapp-db:5432/webapp_sample # pragma: allowlist secret
DB_WAREHOUSE=postgres://warehouse:warehouse@lvao-warehouse-db:5432/warehouse # pragma: allowlist secret

# DBT env vars
POSTGRES_HOST=lvao-warehouse-db
POSTGRES_PORT=5432
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse # pragma: allowlist secret
POSTGRES_DB=warehouse
POSTGRES_SCHEMA=public

# SCALEWAY
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=

# ML-DEDUPLICATION INFERENCE INSTANCE (on-demand Scaleway instance)
# Public key injected into the instance (via server tag AUTHORIZED_KEY=...) so
# the scheduler can SSH in as root. Must match the private key used below.
ML_DEDUPLICATION_SSH_PUB_KEY=
# Private SSH key, base64-encoded (single line) so it fits in a secret env var.
# Decoded to a temp file at runtime by the provisioning scripts. Alternative:
# point ML_DEDUPLICATION_SSH_KEY at a pre-placed key file path instead.
ML_DEDUPLICATION_SSH_KEY_B64=
# Dedicated Scaleway credentials used by the whole ml-deduplication process
# (scw CLI for instance create/wait/destroy/run + registry login on the
# instance). Injected into the scheduler container via its secret. The scw CLI
# standard names (SCW_ACCESS_KEY/SCW_SECRET_KEY) are derived from these.
SCW_ACCESS_KEY_INFRA=
SCW_SECRET_KEY_INFRA=

# ML-DEDUPLICATION LOCAL RUN (mode run_locally du DAG)
# Quand ML_DEDUPLICATION_RUN_LOCAL=1, le DAG n'utilise pas d'instance Scaleway :
# l'inférence tourne localement avec docker (socket docker monté dans le
# conteneur scheduler). En local, ces valeurs permettent de pointer vers le
# warehouse DB de manière accessible depuis le conteneur d'inférence.
ML_DEDUPLICATION_RUN_LOCAL=1
# URI warehouse DB accessible depuis le conteneur d'inférence (via le host).
# Ex: postgresql://warehouse:warehouse@host.docker.internal:8765/warehouse
ML_DEDUPLICATION_DATABASE_URI=
# Réseau docker à rejoindre pour atteindre le warehouse (ex: quefairedemesobjets_default).
# Si vide, on laisse docker choisir le réseau par défaut.
ML_DEDUPLICATION_DOCKER_NETWORK=

