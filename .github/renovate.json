{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "schedule": ["* 0-8 * * 2"],
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "enabledManagers": ["pep621", "npm", "github-actions", "terraform"],
  "ignorePaths": [
    "**/node_modules/**",
    "docs/**",
    "ml_deduplication/**",
    "data-platform/notebooks/**"
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-production-minor-patch"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-development-minor-patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm-minor-patch"
    },
    {
      "description": "Named npm groups, any update type. The last matching rule wins: a package in several groups lands in the lowest one.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript*", "ts-jest", "ts-node"],
      "groupName": "typescript-toolchain"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@testing-library/*"],
      "groupName": "testing"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@gouvfr/*"],
      "groupName": "gouvfr"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/playwright/"],
      "groupName": "playwright"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["postcss*"],
      "groupName": "postcss"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["maplibre-gl", "@maplibre/*"],
      "groupName": "maplibre"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@iframe-resizer/*"],
      "groupName": "iframe-resizer"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@hotwired/*"],
      "groupName": "hotwired"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/eslint/"],
      "groupName": "eslint"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/jest/"],
      "groupName": "jest"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@sentry/*", "sentry*"],
      "groupName": "sentry"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@mapbox/*", "mapbox*"],
      "groupName": "mapbox"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@swc/*", "swc"],
      "groupName": "swc"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@protobufjs/*", "protobufjs"],
      "groupName": "protobufjs"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@parcel/*", "parcel*"],
      "groupName": "parcel"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@babel/*"],
      "groupName": "babel"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions-all"
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "terraform-all"
    },
    {
      "description": "TypeScript 7 (native compiler) has no JS compiler API: ts-jest and typescript-eslint require typescript <7. Drop once they support it.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "@swc/core >=1.16.12 refuses to load its native binding on Scalingo (ERR_SWC_NATIVE_CACHE: build dir parent is group-writable). Pinned via `overrides` in package.json; drop both once SWC relaxes the check.",
      "matchPackageNames": ["@swc/core*"],
      "allowedVersions": "<1.16.12"
    }
  ]
}
