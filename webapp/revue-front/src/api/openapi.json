    "/api/stats": {
      "get": {
        "operationId": "stats_api_stats_endpoint",
        "summary": "Statistiques publiques",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
