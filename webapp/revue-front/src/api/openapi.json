    "/api/qfdmo/acteurs": {
      "get": {
        "operationId": "qfdmo_api_acteurs",
        "summary": "Liste des acteurs actifs",
        "parameters": [
          {
            "in": "query",
            "name": "types",
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "q": "acteur_type__in",
              "title": "Types"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "services",
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "q": "acteur_services__in",
              "title": "Services"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "actions",
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "q": "proposition_services__action_id__in",
              "title": "Actions"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "sous_categories",
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "q": "proposition_services__sous_categories__id__in",
              "title": "Sous Categories"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "latitude",
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Latitude"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "longitude",
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Longitude"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "rayon",
            "schema": {
              "default": 2,
              "title": "Rayon",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedActeurSchema"
                }
              }
            }
          }
        },
        "description": "The actors corresponding to a point on the \"Que faire de mes objets et déchets\" map.\n\nTo find actors near a point:\n- provide a latitude / longitude (example: latitude=48.86 and longitude=2.3)\n- provide a radius (optional) in km: results outside this radius will not be\n  returned\n\nIf the latitude or longitude are missing, then all results will be returned sorted\nby name.",
        "tags": ["Que faire de mes objets"]
      }
    },
