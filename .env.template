# Copy to .env only if you need one of these: the local stack starts without it.
# docker-compose.yml holds the defaults of everything that is not a secret.

# --- Secrets ---------------------------------------------------------------
# S3 storage of the images (Scaleway)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=qfdmo-interface
# AWS_S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# AWS_S3_REGION_NAME=fr-par
# NOTION_TOKEN=
# POSTHOG_PERSONAL_API_KEY=

# Airflow (profile airflow): Scaleway API, used by some DAGs
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_DEFAULT_ORGANIZATION_ID=
# SCW_DEFAULT_PROJECT_ID=
# MATTERMOST_WEBHOOK_URL=
# ml_deduplication DAG on a Scaleway instance (ML_DEDUPLICATION_RUN_LOCAL=0)
# ML_DEDUPLICATION_SSH_PUB_KEY=
# ML_DEDUPLICATION_SSH_KEY_B64=
# SCW_ACCESS_KEY_INFRA=
# SCW_SECRET_KEY_INFRA=

# --- Another Postgres than the Compose one ---------------------------------
# Reached from inside the containers: use host.docker.internal for a Postgres
# running on your machine, not localhost.
# DATABASE_URL=postgres://user:password@host.docker.internal:5432/webapp # pragma: allowlist secret
# DB_WAREHOUSE=postgres://user:password@host.docker.internal:5432/warehouse # pragma: allowlist secret

# --- Host ports, when the defaults are taken -------------------------------
# HTTP_PORT=80
# WEBAPP_PORT=8000
# WEBAPP_DB_PORT=6543
# WAREHOUSE_DB_PORT=8765
# AIRFLOW_PORT=8080
# AIRFLOW_DB_PORT=7654

# --- Behaviour -------------------------------------------------------------
# WITH_DJANGO_DEBUG_TOOLBAR=False
# NGINX_DISABLE_CACHE=1
